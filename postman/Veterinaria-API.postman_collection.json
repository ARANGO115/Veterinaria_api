                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Rutas protegidas",
      "item": [
        {
          "name": "Health - sin token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('indica que se requiere autenticación', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(false);",
                  "  pm.expect(body.message).to.include('Se requiere');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        },
        {
          "name": "Health - token inválido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('indica token inválido', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(false);",
                  "  pm.expect(body.message).to.include('no es válido');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{invalidToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        },
