              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('indica credenciales incorrectas', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(false);",
                  "  pm.expect(body.message).to.include('incorrectos');",
                  "});"
                ]
