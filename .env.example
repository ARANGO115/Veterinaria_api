# Copia este archivo como .env.development y reemplaza los valores de ejemplo.
NODE_ENV=development
PORT=3000

# URI obtenida en MongoDB Atlas > Connect > Drivers.
# Codifica caracteres especiales de usuario/contraseña como %40, %3A, %2F.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/veterinaria?retryWrites=true&w=majority&appName=Cluster0

# Usa un secreto aleatorio propio. No compartas ni subas archivos .env reales.
JWT_SECRET=reemplazar-por-un-secreto-aleatorio-largo
JWT_EXPIRES_IN=1h
